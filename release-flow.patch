new file mode 100644
index 0000000..b2e3fd7
--- /dev/null
+++ b/.github/workflows/release.yml
@@ -0,0 +1,54 @@
+name: release
+
+# Publishes the GitHub release for the number in VERSION. It runs the tests, builds the one-file
+# bootstrap.sh and its checksum, runs the bootstrap tests against that built file in an empty
+# directory, creates the release as a draft with both files attached, then publishes it (an
+# immutable release cannot get files after it is published), and moves the major tag.
+# It changes nothing if that version is already published.
+# The notes come from .github/release-notes/vX.Y.Z.md, which must be in the commit.
+# It runs when VERSION changes on main, or by hand from the Actions tab on main.
+on:
+  push:
+    branches: [main]
+    paths: [VERSION]
+  workflow_dispatch:
+
+permissions:
+  contents: write
+
+concurrency:
+  group: release
+  cancel-in-progress: false
+
+jobs:
+  release:
+    if: github.ref == 'refs/heads/main'
+    runs-on: ubuntu-24.04
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+
+      - uses: actions/setup-python@6d4fd22b20465ccc0f7354476588e8df7c9ca0e0 # v7.1.0
+        with:
+          python-version: '3.12'
+
+      - name: Run the tests
+        run: |
+          python -m pip install pytest
+          python -m pytest tests -q
+
+      - name: Build bootstrap.sh
+        run: python scripts/build_bootstrap.py -o dist/bootstrap.sh
+
+      # The built file goes into a directory with nothing else in it, so a file that it needs
+      # but does not contain makes these tests fail.
+      - name: Test the built file
+        run: |
+          mkdir "$RUNNER_TEMP/download"
+          cp dist/bootstrap.sh "$RUNNER_TEMP/download/"
+          BITES_BOOTSTRAP_SCRIPT="$RUNNER_TEMP/download/bootstrap.sh" python -m pytest tests/test_bootstrap*.py tests/test_preflight.py -q
+
+      - name: Create the draft, attach the files, publish
+        env:
+          GH_TOKEN: ${{ github.token }}
+          TARGET: ${{ github.sha }}
+        run: python scripts/publish_release.py --target "$TARGET" --move-major-tag dist/bootstrap.sh dist/bootstrap.sh.sha256

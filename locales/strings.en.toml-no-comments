output_branch = "{branch} is an output branch; there is nothing to do."
default_branch = "{branch} is the default branch; there is nothing to do."
branch_exists_again = "{branch} exists again; keeping {output_branch}."
no_output_branch = "No {output_branch} branch exists; there is nothing to do."

new file mode 100644
index 0000000..0c40c96
--- /dev/null
+++ b/.github/workflows/release-assets.yml
@@ -0,0 +1,53 @@
+name: release assets
+
+# Attaches the one-file bootstrap.sh and its checksum to a GitHub release. Create the release by
+# hand, for the tag vX.Y.Z that matches the VERSION file; this runs when the release is published.
+# To redo it, run it from the Actions tab with the tag.
+on:
+  release:
+    types: [published]
+  workflow_dispatch:
+    inputs:
+      tag:
+        description: The release tag to attach the files to, for example v1.6.0
+        required: true
+        type: string
+
+permissions:
+  contents: write
+
+concurrency:
+  group: release-assets-${{ github.event.release.tag_name || inputs.tag }}
+  cancel-in-progress: false
+
+jobs:
+  assets:
+    runs-on: ubuntu-24.04
+    steps:
+      - name: Check out the tag
+        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          ref: ${{ github.event.release.tag_name || inputs.tag }}
+
+      - name: Set up Python
+        uses: actions/setup-python@6d4fd22b20465ccc0f7354476588e8df7c9ca0e0 # v7.1.0
+        with:
+          python-version: '3.12'
+
+      # Nothing is attached unless the tests pass on the tagged code.
+      - name: Run the tests
+        run: |
+          python -m pip install pytest
+          python -m pytest tests -q
+
+      # Stops if the tag is not v plus the number in the VERSION file.
+      - name: Build bootstrap.sh
+        env:
+          TAG: ${{ github.event.release.tag_name || inputs.tag }}
+        run: python scripts/build_bootstrap.py -o dist/bootstrap.sh --check-tag "$TAG"
+
+      - name: Attach bootstrap.sh and its checksum to the release
+        env:
+          TAG: ${{ github.event.release.tag_name || inputs.tag }}
+          GH_TOKEN: ${{ github.token }}
+        run: gh release upload "$TAG" dist/bootstrap.sh dist/bootstrap.sh.sha256 --clobber

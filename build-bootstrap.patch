diff --git a/scripts/build_bootstrap.py b/scripts/build_bootstrap.py
new file mode 100755
index 0000000..9065260
--- /dev/null
+++ b/scripts/build_bootstrap.py
@@ -0,0 +1,154 @@
+#!/usr/bin/env python3
+"""Build the release copy of bootstrap.sh: one file that needs nothing next to it.
+
+    python scripts/build_bootstrap.py [-o PATH] [--check-tag TAG]
+
+scripts/bootstrap.sh finds scripts/strings.sh, templates/bites.yml and VERSION next to itself in a
+checkout. The release copy has all three written into it, so that installing bites needs only
+the download:
+
+    curl -fsSLO https://github.com/imdebating/bites/releases/latest/download/bootstrap.sh
+    bash bootstrap.sh OWNER/REPO main
+
+It also runs when the script is piped into bash (`curl ... | bash -s -- OWNER/REPO main`).
+The whole body is wrapped in a function that is called on the last line, so that bash has read
+the entire script before anything runs, and a command that reads standard input (git, ssh)
+cannot swallow the rest of it.
+
+The output goes to PATH (default dist/bootstrap.sh) next to bootstrap.sh.sha256, which holds the
+checksum in the format that `sha256sum -c` and `shasum -a 256 -c` read. The same input always
+gives the same bytes. --check-tag stops the build unless TAG is `v` followed by the VERSION file.
+
+scripts/bootstrap.sh marks what the build replaces with `# >>> release: NAME` and
+`# <<< release: NAME` lines, for the names in BLOCKS below.
+"""
+import argparse
+import hashlib
+import re
+import subprocess
+import sys
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+BLOCKS = ("files", "version", "template check")
+HEREDOC_END = "BITES_TEMPLATE_END"
+
+
+def fail(message):
+    print(f"build_bootstrap.py: {message}", file=sys.stderr)
+    raise SystemExit(1)
+
+
+def read_version(root):
+    version = (root / "VERSION").read_text(encoding="utf-8").strip()
+    if not re.fullmatch(r"[0-9]+\.[0-9]+\.[0-9]+", version):
+        fail(f"VERSION must hold a number such as 1.6.0, not {version!r}")
+    return version
+
+
+def find_block(lines, name):
+    """Return (start, end) line indexes of the marked block `name`, markers included."""
+    start = [i for i, ln in enumerate(lines) if ln == f"# >>> release: {name}"]
+    end = [i for i, ln in enumerate(lines) if ln == f"# <<< release: {name}"]
+    if len(start) != 1 or len(end) != 1 or start[0] > end[0]:
+        fail(f"scripts/bootstrap.sh needs exactly one '# >>> release: {name}' and one matching '# <<<' line")
+    return start[0], end[0]
+
+
+def build(root, version):
+    """Return the text of the release script."""
+    source = (root / "scripts" / "bootstrap.sh").read_text(encoding="utf-8")
+    strings = (root / "scripts" / "strings.sh").read_text(encoding="utf-8")
+    template = (root / "templates" / "bites.yml").read_text(encoding="utf-8")
+    if not template.endswith("\n") or HEREDOC_END in template:
+        fail("templates/bites.yml must end with a newline and must not contain " + HEREDOC_END)
+    if "bites_fmt()" not in strings:
+        fail("scripts/strings.sh does not define bites_fmt")
+
+    lines = source.split("\n")
+    replacement = {
+        "files": [
+            "# ---- scripts/strings.sh, written in by the release build ----",
+            *strings.rstrip("\n").split("\n"),
+            "# ---- templates/bites.yml, written in by the release build ----",
+            "template_text() {",
+            f"  cat <<'{HEREDOC_END}'",
+            *template.rstrip("\n").split("\n"),
+            HEREDOC_END,
+            "}",
+            "# ---- end of the files written in by the release build ----",
+        ],
+        "version": [f'VERSION="{version}"'],
+        "template check": [],
+    }
+    spans = sorted((*find_block(lines, name), name) for name in BLOCKS)
+    for (_, prev_end, _), (next_start, _, _) in zip(spans, spans[1:]):
+        if prev_end >= next_start:
+            fail("the release blocks in scripts/bootstrap.sh overlap")
+    body = lines[:]
+    for start, end, name in reversed(spans):
+        body[start:end + 1] = replacement[name]
+
+    shell_options = [i for i, ln in enumerate(body) if ln == "set -euo pipefail"]
+    if len(shell_options) != 1:
+        fail("scripts/bootstrap.sh needs exactly one 'set -euo pipefail' line")
+    cut = shell_options[0] + 1
+    if not body[0].startswith("#!"):
+        fail("scripts/bootstrap.sh must start with a #! line")
+    built = [
+        body[0],
+        f"# bootstrap.sh {version} - set up bites in a repository with one command.",
+        "#",
+        "# usage: bash bootstrap.sh [options] OWNER/REPO [BRANCH ...]",
+        "#        bash bootstrap.sh [options] --all-branches OWNER/REPO",
+        "#        bash bootstrap.sh --help     (lists every option)",
+        "#",
+        "# This is the release build of scripts/bootstrap.sh in https://github.com/imdebating/bites: one file,",
+        "# with the message catalog and the workflow template written into it. It was generated by",
+        "# scripts/build_bootstrap.py, so change scripts/bootstrap.sh and not this file. The checksum is in",
+        "# bootstrap.sh.sha256 next to it in the release.",
+        "set -euo pipefail",
+        "",
+        "main() {",
+        *body[cut:],
+        "}",
+        'main "$@"; exit $?',
+        "",
+    ]
+    text = "\n".join(built)
+    leftovers = (r"@@VERSION@@", r"BASH_SOURCE", r"(?m)^HERE=", r"\$\{?HERE\b", r"# >>> release", r"# <<< release")
+    for pattern in leftovers:
+        if re.search(pattern, text):
+            fail(f"the release script still contains something only a checkout can use: {pattern}")
+    return text
+
+
+def check_syntax(path):
+    result = subprocess.run(["bash", "-n", str(path)], capture_output=True, text=True)
+    if result.returncode != 0:
+        fail("bash -n rejects the release script:\n" + result.stderr)
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description="Build the one-file release copy of bootstrap.sh.")
+    parser.add_argument("-o", "--output", default=str(ROOT / "dist" / "bootstrap.sh"))
+    parser.add_argument("--check-tag", metavar="TAG", help="stop unless TAG is v followed by the VERSION file")
+    args = parser.parse_args(argv)
+
+    version = read_version(ROOT)
+    if args.check_tag is not None and args.check_tag != f"v{version}":
+        fail(f"the tag {args.check_tag!r} does not match the VERSION file (expected 'v{version}')")
+    text = build(ROOT, version)
+
+    out = Path(args.output)
+    out.parent.mkdir(parents=True, exist_ok=True)
+    out.write_text(text, encoding="utf-8", newline="\n")
+    out.chmod(0o755)
+    check_syntax(out)
+    digest = hashlib.sha256(out.read_bytes()).hexdigest()
+    Path(str(out) + ".sha256").write_text(f"{digest}  {out.name}\n", encoding="utf-8")
+    print(f"{out} ({version}, sha256 {digest})")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tests/test_build_bootstrap.py b/tests/test_build_bootstrap.py
new file mode 100644
index 0000000..52ce3bc
--- /dev/null
+++ b/tests/test_build_bootstrap.py
@@ -0,0 +1,100 @@
+"""Tests for scripts/build_bootstrap.py: the release copy of bootstrap.sh is one file that works alone."""
+import hashlib
+import os
+import shutil
+import subprocess
+import sys
+from pathlib import Path
+
+from gitutil import make_remote, sh
+
+ROOT = Path(__file__).resolve().parent.parent
+BUILD = ROOT / "scripts" / "build_bootstrap.py"
+SOURCE = ROOT / "scripts" / "bootstrap.sh"
+VERSION = (ROOT / "VERSION").read_text(encoding="utf-8").strip()
+WF = ".github/workflows/bites.yml"
+
+
+def build(out, *extra):
+    return subprocess.run([sys.executable, str(BUILD), "-o", str(out), *extra], capture_output=True, text=True)
+
+
+def alone(tmp_path):
+    """Build the release script into an empty directory, with nothing next to it."""
+    folder = tmp_path / "download"
+    folder.mkdir()
+    result = build(folder / "bootstrap.sh")
+    assert result.returncode == 0, result.stderr
+    return folder / "bootstrap.sh"
+
+
+def run_script(script, bare, env, *args):
+    return sh(["bash", str(script), "--url", str(bare), *args], cwd=script.parent, env=env, check=False)
+
+
+def test_the_build_is_reproducible_and_comes_with_a_checksum(tmp_path):
+    first, second = tmp_path / "a" / "bootstrap.sh", tmp_path / "b" / "bootstrap.sh"
+    assert build(first).returncode == 0 and build(second).returncode == 0
+    assert first.read_bytes() == second.read_bytes()
+    digest, name = first.with_name("bootstrap.sh.sha256").read_text(encoding="utf-8").split()
+    assert name == "bootstrap.sh" and digest == hashlib.sha256(first.read_bytes()).hexdigest()
+    assert first.stat().st_mode & 0o111
+
+
+def test_the_release_script_needs_nothing_from_a_checkout(tmp_path):
+    text = alone(tmp_path).read_text(encoding="utf-8")
+    assert "@@VERSION@@" not in text and "BASH_SOURCE" not in text and "$HERE" not in text
+    assert "release:" not in text and '. "$HERE/strings.sh"' not in text
+    assert f'VERSION="{VERSION}"' in text
+    assert text.rstrip().endswith('main "$@"; exit $?')
+
+
+def test_it_prints_its_version_and_help_from_an_empty_directory(tmp_path):
+    script = alone(tmp_path)
+    version = sh(["bash", str(script), "--version"], cwd=script.parent)
+    assert version.stdout.splitlines()[0] == f"bootstrap.sh {VERSION}"
+    checkout = sh(["bash", str(SOURCE), "--help"])
+    assert sh(["bash", str(script), "--help"], cwd=script.parent).stdout == checkout.stdout
+
+
+def test_it_does_exactly_what_the_checkout_does(tmp_path):
+    """Same output, same exit status, same workflow file on the remote."""
+    (tmp_path / "x").mkdir()
+    (tmp_path / "y").mkdir()
+    bare_a, env_a = make_remote(tmp_path / "x", branches=("dev",))
+    bare_b, env_b = make_remote(tmp_path / "y", branches=("dev",))
+    args = ("-c", "max_chars=15000", "owner/repo", "main", "dev")
+    from_checkout = run_script(SOURCE, bare_a, env_a, *args)
+    from_download = run_script(alone(tmp_path), bare_b, env_b, *args)
+    assert from_checkout.returncode == 0, from_checkout.stdout + from_checkout.stderr
+    assert (from_download.returncode, from_download.stdout, from_download.stderr) == \
+        (from_checkout.returncode, from_checkout.stdout, from_checkout.stderr)
+    for branch in ("main", "dev"):
+        shown_a = sh(["git", "show", f"{branch}:{WF}"], cwd=bare_a, env=env_a).stdout
+        shown_b = sh(["git", "show", f"{branch}:{WF}"], cwd=bare_b, env=env_b).stdout
+        assert shown_a == shown_b and "max-chars: 15000" in shown_b
+
+
+def test_it_works_when_piped_into_bash_even_if_a_command_reads_standard_input(tmp_path):
+    """`curl ... | bash -s -- ARGS`: git here reads standard input, as ssh can, and must not eat the script."""
+    script = alone(tmp_path)
+    bare, env = make_remote(tmp_path)
+    fake = tmp_path / "fake"
+    fake.mkdir()
+    real_git = shutil.which("git")
+    shim = fake / "git"
+    shim.write_text(f'#!/bin/sh\nif [ "$1" = clone ]; then cat > /dev/null; fi\nexec "{real_git}" "$@"\n', encoding="utf-8")
+    shim.chmod(0o755)
+    environment = {**env, "PATH": f"{fake}:" + sh(["bash", "-c", "echo $PATH"]).stdout.strip()}
+    done = subprocess.run(["bash", "-s", "--", "--url", str(bare), "owner/repo", "main"], input=script.read_bytes(),
+                          cwd=tmp_path, env={**os.environ, **environment}, capture_output=True)
+    assert done.returncode == 0, done.stdout.decode() + done.stderr.decode()
+    assert b"Setup complete and verified" in done.stdout
+    assert "uses: imdebating/bites@" in sh(["git", "show", f"main:{WF}"], cwd=bare, env=env).stdout
+
+
+def test_the_tag_must_match_the_version_file(tmp_path):
+    out = tmp_path / "bootstrap.sh"
+    wrong = build(out, "--check-tag", "v0.0.0")
+    assert wrong.returncode == 1 and "does not match the VERSION file" in wrong.stderr and not out.exists()
+    assert build(out, "--check-tag", f"v{VERSION}").returncode == 0 and out.exists()
